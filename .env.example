# Salin ke .env. Semua nilai di bawah palsu, ganti untuk lingkungan nyata.
# Pakai 127.0.0.1, bukan localhost: di Windows localhost mencoba IPv6 dulu, sedangkan Compose hanya membuka IPv4.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/inventory
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=15m
PORT=3000
# true = seed akun dan data demo saat container start (hanya untuk demo lokal)
SEED_DEMO=false
